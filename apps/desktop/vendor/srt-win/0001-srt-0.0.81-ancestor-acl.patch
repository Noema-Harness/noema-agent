+/// Grant only FILE_READ_ATTRIBUTES|SYNCHRONIZE on ancestors which the
+/// dedicated sandbox user cannot stat. The state database refcounts
+/// these non-inheritable ACEs with ordinary grants and restores them
+/// after process exit or crash recovery.
+fn grant_ancestor_attrs(
+    db: &srt_win::state_db::Locked,
+    sandbox_sid: &str,
+    targets: &[(String, srt_win::acl::SbAce)],
+) -> anyhow::Result<()> {
+    use anyhow::Context;
+    use srt_win::acl::{SbAce, StatProbe};
+    use srt_win::path_id::{canonical_parent_of, is_unc_path};
+
+    let probe = StatProbe::new(sandbox_sid).context("initialize sandbox ancestor ACL probe")?;
+    let granted: std::collections::HashSet<&str> = targets
+        .iter()
+        .filter(|(_, ace)| matches!(ace, SbAce::Grant(_)))
+        .map(|(path, _)| path.as_str())
+        .collect();
+    let mut seen = std::collections::HashSet::new();
+    for (target, _) in targets
+        .iter()
+        .filter(|(_, ace)| matches!(ace, SbAce::Grant(_)))
+        .filter(|(path, _)| !is_unc_path(path))
+    {
+        let mut parent = canonical_parent_of(target);
+        while let Some(path) = parent {
+            parent = canonical_parent_of(&path);
+            if !seen.insert(path.clone()) {
+                break;
+            }
+            if granted.contains(path.as_str()) || probe.can_stat(&path)? {
+                continue;
+            }
+            let (_, failed) = db.apply_aces(sandbox_sid, &[(path.clone(), SbAce::ReadAttrs)])?;
+            if failed > 0 {
+                anyhow::bail!(
+                    "could not grant the sandbox's metadata-only traversal right on ancestor '{path}'"
+                );
+            }
+        }
+    }
+    Ok(())
+}
