+    pub read_attrs: bool,
 }

 impl SbAceSet {
-    /// The set's DENY entries as [`NewAce`]s for `sid`, deny →
-    /// deny-delete → deny-fdc, and its ALLOW entry.
+    /// The set's entries as [`NewAce`]s for `sid`, with read-attributes
+    /// kept object-only. The state database has already merged holders,
+    /// so only one grant and one metadata ACE can be present.
     fn aces(&self, sid: PSID) -> (Vec<NewAce>, Vec<NewAce>) {
         let mut v = Vec::with_capacity(3);
         if let Some(m) = self.deny {
@@ -1095,13 +1117,35 @@ impl SbAceSet {
         if self.deny_fdc {
             v.push(NewAce::Deny(sid, Mask::FILE_DELETE_CHILD.bits(), OICI));
         }
-        let allow = self
+        let mut allow: Vec<NewAce> = self
             .grant
             .map(|m| NewAce::Allow(sid, m.bits(), OICI))
             .into_iter()
             .collect();
+        if self.read_attrs {
+            allow.push(NewAce::Allow(sid, Mask::FILE_PATH_ACCESS.bits(), NO_INHERIT));
+        }
