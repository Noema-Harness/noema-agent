+
+fn has_broad_write_allow_in(aces: Option<&[AceView]>) -> bool {
+    const EVERYONE: &str = "S-1-1-0";
+    const AUTHENTICATED_USERS: &str = "S-1-5-11";
+    const BUILTIN_USERS: &str = "S-1-5-32-545";
+    const FILE_WRITE_MASK: u32 = 0x0000_0002 // FILE_WRITE_DATA / FILE_ADD_FILE
+        | 0x0000_0004 // FILE_APPEND_DATA / FILE_ADD_SUBDIRECTORY
+        | 0x0000_0010 // FILE_WRITE_EA
+        | 0x0000_0100 // FILE_WRITE_ATTRIBUTES
+        | 0x0001_0000 // DELETE
+        | 0x0004_0000 // WRITE_DAC
+        | 0x0008_0000 // WRITE_OWNER
+        | 0x4000_0000 // GENERIC_WRITE
+        | 0x1000_0000; // GENERIC_ALL
+
+    let trustees = [EVERYONE, AUTHENTICATED_USERS, BUILTIN_USERS];
+    let Some(aces) = aces else {
+        // A null DACL grants full access to everyone.
+        return true;
+    };
+    aces.iter().any(|ace| {
+        !ace.deny && trustees.contains(&ace.sid.as_str()) && ace.mask & FILE_WRITE_MASK != 0
+    })
+}
