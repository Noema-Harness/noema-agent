+/// Whether a root DACL contains an ordinary write allow for a SID
+/// that every local sandbox account belongs to. This intentionally
+/// errs on the side of selecting an extra root: the resulting deny is
+/// scoped to the dedicated sandbox SID, never to other users.
+pub fn has_broad_write_allow(canonical_path: &str) -> Result<bool> {
+    let dacl = read_dacl_views(DaclTarget::Path(canonical_path))?;
+    Ok(has_broad_write_allow_in(dacl.as_deref()))
