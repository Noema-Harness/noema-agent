{
  "name": "noema",
  "version": "0.7.6",
  "private": true,
  "description": "Noema personal agent",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run start --workspace noema-desktop",
    "lint": "npm run lint --workspace noema-desktop",
    "typecheck": "npm run typecheck --workspace noema-desktop",
    "test": "npm test --workspace noema-desktop",
    "smoke": "npm run smoke --workspace noema-desktop",
    "e2e:dsh-fake-model": "npm run e2e:dsh-fake-model --workspace noema-desktop",
    "smoke:package": "npm run smoke:package --workspace noema-desktop",
    "package:desktop": "npm run package --workspace noema-desktop",
    "make:desktop": "npm run make --workspace noema-desktop",
    "workspace:check": "node scripts/workspace.mjs check && node scripts/branches.mjs check",
    "workspace:clean": "node scripts/workspace.mjs clean",
    "branches:check": "node scripts/branches.mjs check",
    "branches:prune": "node scripts/branches.mjs prune",
    "branches:test": "node --test scripts/branches.test.mjs",
    "source:check": "node scripts/source-structure.mjs",
    "check": "node scripts/governance.mjs milestone",
    "docs:check": "node scripts/maintenance.mjs docs",
    "figure:check": "node scripts/figure.mjs check",
    "maintenance:test": "node --test scripts/maintenance.test.mjs",
    "figure:build": "node scripts/figure.mjs build all",
    "figure:test": "node --test scripts/figure.test.mjs",
    "inbox": "node scripts/inbox.mjs list",
    "tools:test": "node --test scripts/governance.test.mjs && node --test scripts/maintenance.test.mjs && node --test scripts/figure.test.mjs && node --test scripts/branches.test.mjs && node --test scripts/workspace.test.mjs && node --test scripts/skill-sync.test.mjs && node --test scripts/collaboration.test.mjs && node --test governance/core/state.test.mjs && node --test scripts/work-view.test.mjs && node --test scripts/quickstart.test.mjs",
    "governance:test": "node --test scripts/governance.test.mjs",
    "skill:install": "node scripts/skill-sync.mjs install",
    "guard": "node scripts/collaboration.mjs",
    "state": "node scripts/state.mjs",
    "state:test": "node --test governance/core/state.test.mjs",
    "inbox:ack": "node scripts/inbox.mjs ack",
    "work:view": "node scripts/work-view.mjs"
  },
  "engines": {
    "node": ">=24.21 <25"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "better-sqlite3@13.0.3": true
  }
}
