{
  "schemaVersion": 3,
  "artifactRoot": ".work",
  "specificationRoot": "openspec/specs",
  "branchBase": "origin/main",
  "currentDocuments": [
    "AGENTS.md",
    "README.md",
    "CONTRIBUTING.md",
    "docs/PRODUCT.md",
    "docs/ARCHITECTURE.md",
    "docs/DECISIONS.md",
    "docs/OPERATIONS.md",
    "docs/STATUS.md"
  ],
  "rootDirectories": [
    ".archify",
    ".git",
    ".githooks",
    ".github",
    ".work",
    "apps",
    "docs",
    "node_modules",
    "openspec",
    "plugins",
    "scripts",
    "skills"
  ],
  "cleanableArtifacts": [
    ".work/runs",
    ".work/scratch"
  ],
  "artifactRetention": {
    "days": 7,
    "keep": [
      ".work/releases",
      ".work/archive",
      ".work/inbox-bridge",
      ".work/session-compact"
    ]
  },
  "generatedDirectories": [
    ".archify",
    "apps/desktop/.vite",
    "apps/desktop/coverage",
    "apps/desktop/out",
    "coverage"
  ]
}
